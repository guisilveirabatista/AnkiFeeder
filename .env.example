# Copy to .env and fill in values:
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Desktop (noVNC / VNC)
# ---------------------------------------------------------------------------
RESOLUTION=1920x1080
NOVNC_HOST_PORT=6080
VNC_HOST_PORT=5900
# Leave empty for no VNC password (fine on localhost; set one if exposed)
VNC_PASSWORD=

# ---------------------------------------------------------------------------
# AnkiWeb account
# Used by the bundled "AnkiWeb Env Login" add-on on first start.
# After a successful login the session lives in the anki-data volume.
# ---------------------------------------------------------------------------
ANKIWEB_EMAIL=
ANKIWEB_PASSWORD=
ANKIWEB_SYNC_ON_LOGIN=1

# ---------------------------------------------------------------------------
# Obsidian account
# There is no supported non-interactive Obsidian Sync login API.
# These values are written into ~/DESKTOP-SETUP.txt inside the container so
# you can sign in once via the noVNC desktop (Settings → Account / Sync).
# After that, the obsidian-config volume keeps you signed in.
# ---------------------------------------------------------------------------
OBSIDIAN_EMAIL=
OBSIDIAN_PASSWORD=

# Host folder mounted as the Obsidian vault (create it if missing)
OBSIDIAN_VAULT_HOST=./vault

# ---------------------------------------------------------------------------
# AnkiFeeder
# ---------------------------------------------------------------------------
TRANSLATOR=gemini
NOTE_PATH=/vault/Vocabulary.md
DECK_NAME=Obsidian Vocabulary
SOURCE_LANGUAGE=English
TARGET_LANGUAGE=Dutch

# Set the key that matches TRANSLATOR (only one is required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional model overrides
# CLAUDE_MODEL=claude-opus-4-8
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-2.5-flash-lite

# AnkiConnect published on the host (optional)
ANKICONNECT_HOST_PORT=8765

# Optional image version pins
# ANKI_VERSION=26.08
# OBSIDIAN_VERSION=1.13.4
